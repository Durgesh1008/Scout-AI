# ==============================================================================
# Git Ignore Configuration for Scout-AI
# Ensure no sensitive keys, private resumes, or databases are committed!
# ==============================================================================

# Environment files & Secrets
.env
.env.*
.env.local
!.env.example
*.pem
*.key
*.cert
credentials.json
token.json

# Python runtime & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# User Data, Databases, Resumes & Drafts (Private)
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.csv
data/resume.*
data/resumes/*
!data/resumes/.gitkeep
data/drafts/*
!data/drafts/.gitkeep
app/Resume/*
!app/Resume/.gitkeep
uploads/*
!uploads/.gitkeep

# System & Application Logs
*.log
uvicorn_*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
