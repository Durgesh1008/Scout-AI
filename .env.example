# ==============================================================================
# SCOUT-AI ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your keys:
#   cp .env.example .env
#
# NOTE: Never commit your real '.env' file to Git or public repositories.
# ==============================================================================

# Core Application Settings
APP_NAME=Scout-AI
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 1. LLM PROVIDER SELECTION
# ------------------------------------------------------------------------------
# Choose one of: "gemini" | "groq" | "ollama"
LLM_PROVIDER=gemini

# Google Gemini API (Recommended - Free Tier: 15 RPM / 1M TPM)
# Obtain free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API (Ultra-low latency - Free Tier: 30 RPM)
# Obtain free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama (100% Offline & Private)
# Download from: https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 2. LOCAL STORAGE & DATA TRACKING
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/assistant.db
RESUME_PATH=./data/resume.pdf
CSV_TRACKER_PATH=./data/job_tracker.csv

# ------------------------------------------------------------------------------
# 3. AUTONOMOUS JOB HUNTING & MATCHING ENGINE
# ------------------------------------------------------------------------------
MATCH_THRESHOLD=35
DAILY_JOB_LIMIT=70
TARGET_ROLES=MERN Stack Developer,Backend Developer,Full Stack Developer,Software Engineer,SDE,Java Developer,Python Developer,Node.js Developer,Frontend Developer,React Developer,Angular Developer,Vue.js Developer
JOB_LOCATION_PREFERENCE=India + Remote
EXPERIENCE_LEVEL=0-2 years

# Optional RapidAPI / JSearch Key (Aggregates LinkedIn, Indeed, Glassdoor & Wellfound)
# Free tier key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Auto-cleanup (Hours before unreviewed jobs are purged from local database)
JOB_EXPIRY_HOURS=18

# ------------------------------------------------------------------------------
# 4. EMAIL OUTREACH & DRAFT AUTOMATION
# ------------------------------------------------------------------------------
# Generate a 16-character Google App Password:
# https://myaccount.google.com/apppasswords (Requires 2FA enabled)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ------------------------------------------------------------------------------
# 5. MULTI-CHANNEL DISPATCH NOTIFICATIONS
# ------------------------------------------------------------------------------
# Telegram Bot Token (Create via @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook URL (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Native Windows Desktop Toast Notifications (True/False)
ENABLE_DESKTOP_NOTIFICATIONS=True

# ------------------------------------------------------------------------------
# 6. SCHEDULE & TIMEZONE
# ------------------------------------------------------------------------------
MORNING_TIME=08:00
TIMEZONE=Asia/Kolkata
