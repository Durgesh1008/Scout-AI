# ==============================================================================
# Scout-AI Configuration Template (.env.example)
# Copy this file to '.env' and fill in your keys and preferences.
# Never commit your actual '.env' file containing real secrets to version control!
# ==============================================================================

APP_NAME=Scout-AI
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 1. LLM Provider Selection
# Options: "gemini" (recommended, fast & free), "groq" (ultra fast & free), or "ollama" (offline local)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google Gemini (Free tier available at: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud (Free tier available at: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama (Free & open source at: https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 2. Storage & Job Tracker Paths
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/assistant.db
RESUME_PATH=./data/resume.pdf
CSV_TRACKER_PATH=./data/job_tracker.csv

# ------------------------------------------------------------------------------
# 3. Job Hunter Preferences & Filtering
# ------------------------------------------------------------------------------
MATCH_THRESHOLD=35
DAILY_JOB_LIMIT=70
TARGET_ROLES=MERN Stack Developer,Backend Developer,Full Stack Developer,Software Engineer,SDE,Java Developer,Python Developer,Node.js Developer,Frontend Developer,React Developer
JOB_LOCATION_PREFERENCE=India + Remote
EXPERIENCE_LEVEL=0-2 years

# Optional RapidAPI / JSearch API Key (Aggregates LinkedIn, Indeed, Glassdoor & Wellfound)
# Get a free key at: https://rapidapi.com/letscrape-6bRBa3qigO/api/jsearch
RAPIDAPI_KEY=

# Auto-cleanup: Hours before unreviewed/stale jobs are cleaned up (default: 18)
JOB_EXPIRY_HOURS=18

# ------------------------------------------------------------------------------
# 4. Email Automation (Gmail IMAP Drafts + SMTP Outreach)
# Generate a free 16-character App Password at: https://myaccount.google.com/apppasswords
# (Requires 2-Factor Authentication enabled on your Google Account)
# ------------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Multi-Channel Notifications (Optional)
# ------------------------------------------------------------------------------
# Telegram Bot (Free via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook (Channel Settings -> Integrations -> Webhooks -> New Webhook)
DISCORD_WEBHOOK_URL=

# Native Desktop Toast Notifications (True/False)
ENABLE_DESKTOP_NOTIFICATIONS=True

# ------------------------------------------------------------------------------
# 6. Scheduling & Timezone
# ------------------------------------------------------------------------------
MORNING_TIME=08:00
TIMEZONE=Asia/Kolkata
